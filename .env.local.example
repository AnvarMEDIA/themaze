# ── Required ──────────────────────────────────────────────────────────────────

# Admin panel credentials
ADMIN_PASSWORD=your-strong-password-here
JWT_SECRET=your-32-character-secret-key-here

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.maze.uz

# ── File storage ──────────────────────────────────────────────────────────────

# Vercel Blob token — required in production for image/file uploads.
# Get from: vercel.com/dashboard → Storage → Blob → Create Token
# Without this, uploads fall back to /public/uploads/ (dev only).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── AI features ───────────────────────────────────────────────────────────────

# Anthropic API key — required for AI translate and generate-seo features.
# Get from: console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=sk-ant-...

# ── Notifications ─────────────────────────────────────────────────────────────

# Telegram bot for contact form & brief submissions.
# 1. Talk to @BotFather → create bot → copy token.
# 2. Add bot to your group/channel and send any message.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates → copy chat.id
#    (group IDs are negative).
# Without these, forms work but won't send Telegram notifications.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=-100123456789

# ── Rate limiting ─────────────────────────────────────────────────────────────

# Upstash Redis for distributed rate limiting.
# Get from: upstash.com → Create Database → REST API
# Without these, rate limiting falls back to in-memory (single-instance only).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── SEO / Indexing ────────────────────────────────────────────────────────────

# IndexNow key for instant search-engine indexing on content changes.
# Generate any random string (e.g. openssl rand -hex 16).
# Also create /public/<your-key>.txt containing just that string.
# INDEXNOW_KEY=your-indexnow-key

# ── Cron jobs ─────────────────────────────────────────────────────────────────

# Secret to authenticate Vercel Cron requests.
# Set the same value in vercel.json cron authorization header.
# CRON_SECRET=your-cron-secret

# ── Optional: Postgres / Vercel KV ────────────────────────────────────────────

# If set, the data store uses Postgres instead of Vercel Blob JSON files.
# Provisioned automatically by Vercel Postgres add-on.
# POSTGRES_URL=postgres://...
# POSTGRES_URL_NON_POOLING=postgres://...
# POSTGRES_PRISMA_URL=prisma://...

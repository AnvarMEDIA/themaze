# Admin credentials
ADMIN_PASSWORD=your-strong-password-here
JWT_SECRET=your-32-character-secret-key-here

# Site URL (update for production)
NEXT_PUBLIC_SITE_URL=https://www.maze.uz

# Telegram alerts for new contact-form inquiries.
# Without these the inquiry is still saved and visible in /admin/inquiries,
# but nobody is notified about it.
#   1. Create a bot with @BotFather -> it gives you the token
#   2. Add the bot to your chat/group, send it any message
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
#      (group ids are negative, e.g. -1001234567890)
#   4. Set both here / in the Vercel project settings, then redeploy and press
#      "Send test message" in Admin -> Settings -> Inquiry alerts
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_CHAT_ID=-1001234567890

# Optional: Vercel Blob token for production file uploads
# Get from: vercel.com/dashboard → Storage → Blob → Create Token
# BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

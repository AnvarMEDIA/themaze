# Admin credentials
ADMIN_PASSWORD=your-strong-password-here
JWT_SECRET=your-32-character-secret-key-here

# Site URL (update for production)
NEXT_PUBLIC_SITE_URL=https://www.maze.uz

# Optional: Vercel Blob token for production file uploads
# Get from: vercel.com/dashboard → Storage → Blob → Create Token
# BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Telegram notifications for contact & brief form submissions
# 1. Talk to @BotFather, create a bot, copy its token.
# 2. Add the bot to your group/channel (or DM it from your account)
#    and send any message.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates in a browser
#    and copy the numeric chat.id (group IDs are negative).
# Without these vars, form submissions still work — they just won't
# ping Telegram.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=-100123456789
